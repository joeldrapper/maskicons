{
	"name": "maskicons",
	"version": "0.1.0",
	"description": "Icons as Tailwind utilities.",
	"type": "module",
	"main": "dist/index.js",
	"style": "dist/index.css",
	"exports": {
		".": {
			"style": "./dist/index.css",
			"default": "./dist/index.js"
		},
		"./utilities": {
			"style": "./dist/utilities.css",
			"default": "./dist/utilities.js"
		},
		"./tabler-outline": {
			"style": "./dist/tabler-outline.css",
			"default": "./dist/tabler-outline.js"
		},
		"./tabler-filled": {
			"style": "./dist/tabler-filled.css",
			"default": "./dist/tabler-filled.js"
		},
		"./bootstrap": {
			"style": "./dist/bootstrap.css",
			"default": "./dist/bootstrap.js"
		},
		"./flags": {
			"style": "./dist/flags.css",
			"default": "./dist/flags.js"
		},
		"./flags-square": {
			"style": "./dist/flags-square.css",
			"default": "./dist/flags-square.js"
		}
	},
	"files": [
		"dist",
		"licenses"
	],
	"scripts": {
		"build": "bun run src/build.ts",
		"test": "bun run build && node test/compare.ts",
		"bench": "bun run build && node test/bench.ts"
	},
	"devDependencies": {
		"@tailwindcss/node": "4.3.3",
		"@tailwindcss/oxide": "4.3.3",
		"@tailwindcss/vite": "4.3.3",
		"@types/bun": "^1.3.4",
		"maskicons-release": "npm:maskicons@0.1.0",
		"svgo": "^4.0.0",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"tailwindcss": "^4.1.17"
	}
}
